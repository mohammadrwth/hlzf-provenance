# Copy to .env (never commit .env). Without ZAI_API_KEY the pipeline replays data/cache only.
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4/

# Verified against docs.z.ai on 2026-10-03.
GLM_EXTRACT_MODEL=glm-5.3          # text-only, always reasons
GLM_CHECK_MODEL=glm-5.3-flash      # multimodal: reads the rendered page images
GLM_OCR_MODEL=glm-ocr              # layout_parsing endpoint, used for scans and the parse swap
GLM_REASONING_EFFORT=low           # low | high | max
GLM_TEMPERATURE=1.0

# Hard stop for live spend, in USD (counted from the cost log in data/hlzf.db).
LLM_BUDGET_USD=5

# Resamples per document for fault attribution (Htrace used 10).
HLZF_RESAMPLES=5

# Model calls in flight at once; lower it if Z.ai answers with rate-limit errors (429/1302).
HLZF_PARALLEL=4

# 1 = when GLM-OCR and the vision model agree on a disputed table cell against the text
# reading, and every agreed value is printed in that cell, set the cell to it automatically
# (status auto-corrected, recorded in PROV). 0 = only suggest, a person decides.
HLZF_AUTOCORRECT=1

# 1 = never call the API, replay the cache only.
HLZF_OFFLINE=0

# Name recorded as the PROV agent for review decisions.
HLZF_REVIEWER=Mo

# Uploaded PDFs (web UI, `hlzf add`): limits per file
HLZF_UPLOAD_MAX_MB=25
HLZF_UPLOAD_MAX_PAGES=20
